{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelos-suite-api",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelos-suite",
      "database_id": "3813ffa8-3b13-47eb-ae92-0c70d3a0821d",
      "migrations_dir": "src/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "travelos-suite-documents"
    }
  ],
  "routes": [
    {
      "pattern": "travelcrm.zaqone.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
